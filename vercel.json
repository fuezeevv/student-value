{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm ci --include=dev",
  "buildCommand": "npm run build:vercel",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "src/app/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/**/*.tsx": {
      "maxDuration": 30
    },
    "src/app/api/calendar/cron/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/calendar/cron",
      "schedule": "0 5 * * *"
    }
  ]
}
