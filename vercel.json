{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build:vercel",
  "regions": ["fra1"],
  "git": { "deploymentEnabled": false },
  "functions": {
    "src/app/**/*.ts": { "maxDuration": 30 },
    "src/app/**/*.tsx": { "maxDuration": 30 }
  }
}
