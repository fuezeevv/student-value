ALLOW_DEV_AUTH=false
DATABASE_URL=postgresql://APP_ROLE:REPLACE_IN_SECRET_MANAGER@ep-REPLACE-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&sslaccept=strict&connection_limit=3&connect_timeout=15&pool_timeout=15
