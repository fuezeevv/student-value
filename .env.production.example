# Documentation only. Do not store real secrets in Git or send them in chat.
# Render populates DATABASE_URL from the managed database and generates the action key.
NODE_ENV=production
APP_ORIGIN=https://studentvalue1984.eu.cc
ALLOW_DEV_AUTH=false
DATABASE_URL=postgresql://USER:REPLACE_IN_SECRET_MANAGER@PRIVATE_DATABASE_HOST/studentvalue1984
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=REPLACE_WITH_PERSISTENT_32_BYTE_BASE64_KEY
TZ=Europe/Moscow
PORT=10000
NEXT_TELEMETRY_DISABLED=1
# Do not set NEXT_DIST_DIR, SV_TEST_ISOLATED or TEST_DATABASE_URL in production.
# Google/Telegram credentials are intentionally absent: these integrations are not implemented.
